# ============================================================
# EtiquetaFlash · .env.example
# Copiá este archivo a .env y completá los valores reales.
# NUNCA pushees el archivo .env real al repositorio.
# ============================================================

# ---------- App ----------
NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET=cambia-este-valor-en-produccion

# Clave de cifrado para tokens guardados en DB (32 bytes hex).
# Generar con: openssl rand -hex 32
ENCRYPTION_KEY=cambia-este-valor-32-bytes-hex-en-produccion-1234567890abcdef

# Si está en true, no se llama a ninguna API externa: se devuelve mock data.
# Útil para desarrollar sin credenciales de Tienda Nube ni Correo.
MOCK_MODE=true

# ---------- PostgreSQL ----------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/etiquetaflash?schema=public

# ---------- Usuario admin inicial (se crea con `npm run db:seed`) ----------
ADMIN_EMAIL=admin@tilesconcept.com
ADMIN_PASSWORD=cambiame123

# ============================================================
# Tienda Nube / Nuvemshop
# https://dev.tiendanube.com/docs/api
# Creá una app en https://partners.tiendanube.com/
# ============================================================
TIENDANUBE_APP_ID=
TIENDANUBE_CLIENT_SECRET=
# Después del OAuth se completan estos (o se guardan cifrados en DB):
TIENDANUBE_STORE_ID=
TIENDANUBE_ACCESS_TOKEN=
# User-Agent obligatorio para la API de Nuvemshop (formato: "Nombre (contacto@dominio.com)")
TIENDANUBE_USER_AGENT=EtiquetaFlash (admin@tilesconceptar.com)

# ============================================================
# Correo Argentino / PAQ.AR / MiCorreo
# TODO: completar con los datos del contrato comercial.
# La API NO es pública: hay que solicitarla al área de eCommerce
# de Correo Argentino y firmar el convenio correspondiente.
# Endpoints típicos: SOAP/REST con WSDL provisto por Correo.
# ============================================================
CORREO_AR_API_URL=https://api-placeholder.correoargentino.com.ar
CORREO_AR_USER=
CORREO_AR_PASSWORD=
CORREO_AR_CONTRATO=
CORREO_AR_CLIENTE_ID=

# ============================================================
# Sinergia Logística
# TODO: completar cuando se obtenga documentación.
# ============================================================
SINERGIA_API_URL=https://api-placeholder.sinergia.com.ar
SINERGIA_API_KEY=
SINERGIA_CLIENT_ID=
