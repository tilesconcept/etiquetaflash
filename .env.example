# ============================================================
# EtiquetaFlash · .env.example
# Copiá este archivo a .env y completá los valores reales.
# NUNCA pushees el archivo .env real al repositorio.
# ============================================================

# ---------- App ----------
NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET=cambia-este-valor-en-produccion

# ---------- PostgreSQL ----------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/etiquetaflash?schema=public

# ---------- Usuario admin inicial (se crea con `npm run db:seed`) ----------
ADMIN_EMAIL=admin@tilesconceptar.com
ADMIN_PASSWORD=cambiame123

# ============================================================
# IMPORTANTE
# Esta versión NO se conecta a las APIs de Correo Argentino ni Sinergia.
# El flujo es: subir PDFs de etiquetas de Tienda Nube → generar CSV/XLSX
# de carga masiva para cada plataforma → descargar y subir manualmente.
# ============================================================
