// EtiquetaFlash · esquema Prisma
// Documentación: https://www.prisma.io/docs

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------
// Usuarios internos de Tiles Concept
// ---------------------------------------------------------------
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         UserRole @default(OPERATOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  exports Export[]
}

enum UserRole {
  ADMIN
  OPERATOR
}

// ---------------------------------------------------------------
// Configuración de la app (single-tenant): paquete default y remitente.
// ---------------------------------------------------------------
model Settings {
  id                    String  @id @default(cuid())
  // singleton: usamos id="default"

  // Paquete default
  defaultProductType    String  @default("CP")    // CP|EP|UP (Correo Argentino)
  defaultLengthCm       Float   @default(20)
  defaultWidthCm        Float   @default(15)
  defaultHeightCm       Float   @default(10)
  defaultWeightKg       Float   @default(1.0)
  defaultContentValue   Float   @default(0)       // valor declarado en ARS

  // Sinergia
  defaultFlexId         String  @default("flex")  // se imprime literal en columna ID FLEX

  // Remitente (no se usa en los Excel de carga masiva, pero queda para etiqueta interna)
  originName            String  @default("Tiles Concept")
  originStreet          String  @default("")
  originNumber          String  @default("")
  originCity            String  @default("")
  originProvince        String  @default("")
  originPostalCode      String  @default("")
  originPhone           String  @default("")
  originEmail           String  @default("")

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// ---------------------------------------------------------------
// Orden / envío parseado desde un PDF de Tienda Nube.
// Cada Order corresponde a una línea del Excel de carga masiva.
// ---------------------------------------------------------------
model Order {
  id                String   @id @default(cuid())

  // Identificación
  orderNumber       String                       // ej. "397"
  packageNumber     String?                      // ej. "1"
  source            OrderSource @default(PDF_UPLOAD)
  sourceFileName    String?
  tiendaNubeOrderId String?                      // si vino por API; null si vino por PDF
  pdfRawText        String?  @db.Text            // texto crudo del PDF (auditoría)

  // Operador detectado (editable por el usuario)
  carrier           Carrier  @default(CORREO_ARGENTINO)
  shippingMode      ShippingMode @default(HOME)

  // Sucursal de retiro (solo si shippingMode = PICKUP_BRANCH)
  pickupBranchName       String?
  pickupBranchAddress    String?
  pickupBranchCode       String?                 // código de 3 letras para CA (ej "RBA"). Si null lo intentamos resolver.

  // Destinatario
  recipientName     String
  recipientEmail    String?
  recipientPhone    String?
  recipientPhoneAreaCode String?                 // separado para CA (cod_area_cel)
  recipientPhoneNumber   String?                 // separado para CA (cel)
  recipientDni      String?

  // Dirección de destino (si shippingMode = HOME)
  shipStreet        String?
  shipNumber        String?
  shipFloor         String?
  shipApartment     String?
  shipBetweenStreets String?                     // entrecalles (Sinergia)
  shipLocality      String?                      // localidad / city
  shipPartido       String?                      // partido / municipality (Sinergia)
  shipProvince      String?                      // nombre completo de la provincia
  shipProvinceCode  String?                      // letra única para CA (B, C, X, etc.)
  shipPostalCode    String?                      // CP o CPA (1414 o C1414AAA)

  // Paquete (override sobre defaults)
  productType       String?                      // CP|EP|UP override
  lengthCm          Float?
  widthCm           Float?
  heightCm          Float?
  weightKg          Float?
  contentValue      Float?

  // Sinergia
  flexId            String?                      // ID FLEX override
  shipmentDetail    String?                      // DETALLE DEL ENVIO

  // Productos (resumen + JSON detallado)
  productsSummary   String?                      // ej. "GIZA · Camel x1"
  productsJson      Json?

  // Estado
  exported          Boolean  @default(false)     // ya se incluyó en algún Export
  lastExportId      String?
  notes             String?  @db.Text

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  exportItems       ExportItem[]

  @@unique([orderNumber, packageNumber])
  @@index([carrier, exported])
  @@index([createdAt])
}

enum OrderSource {
  PDF_UPLOAD
  MANUAL
  TIENDANUBE_API
}

enum Carrier {
  CORREO_ARGENTINO
  SINERGIA
  OTRO
}

enum ShippingMode {
  HOME
  PICKUP_BRANCH
}

// ---------------------------------------------------------------
// Cada vez que se genera un Excel de carga masiva queda un registro acá.
// ---------------------------------------------------------------
model Export {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  platform    Carrier                            // CORREO_ARGENTINO | SINERGIA
  fileName    String
  filePath    String
  mimeType    String   @default("text/csv")
  rowCount    Int
  sizeBytes   Int?

  createdAt   DateTime @default(now())

  items       ExportItem[]
}

model ExportItem {
  id        String @id @default(cuid())
  exportId  String
  export    Export @relation(fields: [exportId], references: [id], onDelete: Cascade)
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([exportId, orderId])
}
